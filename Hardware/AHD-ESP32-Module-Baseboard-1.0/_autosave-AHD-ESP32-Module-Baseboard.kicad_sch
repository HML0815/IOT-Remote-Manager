	(text "Strapping Pins:\n\n- Boot mode: GPIO0 and GPIO2\n  Normal Boot: GPIO0=1 and GPIO2=X\n  UART Loader: GPIO0=0 and GPIO2=0\n\n- SDIO Voltage: GPIO12=0 for normal 3.3V\n  \n- U0TXD Printing: GPIO15=1 enables (normal)\n"
		(exclude_from_sim no)
		(at 219.71 157.48 0)
		(effects
			(font
				(face "Lucida Console")
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "398a4423-2a50-43e9-95f6-f9b79dfc8a9e")
	)
	(text "References:\nhttps://mischianti.org/integrating-lan8720-with-esp32-for-ethernet-connectivity-with-plain-http-and-ssl-https/"
