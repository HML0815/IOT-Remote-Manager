		(uuid "8c860fe5-34cd-4c76-8c47-16510905599e")
	)
	(text "PHY set up as follows:\nMODE: All capable(10/100Base)\n-Auto-negotiation enabled\n-RMII Configuration\n-SMI address: 0x00\n-REGOFF=0 at POR (1.2V Reg stays on)\n-nINTSEL=1 at POR so that CLKIN is used and no REFCLKO"
		(exclude_from_sim no)
		(at 57.658 126.746 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "9469c974-3258-4c01-b78c-96dc859d9c7d")
	)
	(text "Slave Address for Various I2C Devices\n6543210\n-------\n1110000 - PCA9538A (GPIO)\n1110100 - TCA9546A (4xI2C Mux)\n1110AAA - TCA9548A (8xI2C Mux alternative)\n1010110 - MB85RC64 FRAM (Was 1010010)\n10100XX - 24C02 EEPROM on plug-in cards\n1010001 - PCF2129 RTCC\n1101111 - MCP7940N RTCC\n0111000 - ADE7854A\n0100000 - MCP23017\n"
		(exclude_from_sim no)
		(at 80.01 239.014 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9f5c7a80-7220-432e-865b-d1468e8a8d4c")
	)
